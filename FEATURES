import tkinter as tk
from tkinter import scrolledtext
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.metrics.pairwise import cosine_similarity

# FAQ Dataset
questions = [
    "What is the college working time?",
    "How can I apply for admission?",
    "What courses are available?",
    "How can I contact the college?",
    "What is the fee structure?",
    "How can I pay the fees?",
    "Where is the college located?",
    "What documents are required for admission?"
]

answers = [
    "The college working hours are 9:00 AM to 4:30 PM.",
    "You can apply for admission through the college admission portal.",
    "The college offers various undergraduate and postgraduate courses.",
    "You can contact the college through the official office contact number.",
    "The fee structure depends on the selected course.",
    "Fees can be paid through the college office or online payment facility.",
    "The college is located at the address mentioned on the official website.",
    "Required documents include marksheets, transfer certificate, ID proof and passport-size photographs."
]

# Convert FAQ questions into TF-IDF vectors
vectorizer = TfidfVectorizer()
faq_vectors = vectorizer.fit_transform(questions)


def get_answer(user_question):

    user_vector = vectorizer.transform([user_question])

    similarity = cosine_similarity(
        user_vector,
        faq_vectors
    )

    best_match = similarity.argmax()
    score = similarity[0][best_match]

    # Similarity threshold
    if score < 0.25:
        return "Sorry, I could not find a suitable answer. Please ask another question."

    return answers[best_match]


def send_message():

    user_question = entry.get().strip()

    if user_question == "":
        return

    chat_box.insert(
        tk.END,
        "You: " + user_question + "\n"
    )

    answer = get_answer(user_question)

    chat_box.insert(
        tk.END,
        "AI Assistant: " + answer + "\n\n"
    )

    entry.delete(0, tk.END)


# Create GUI
window = tk.Tk()
window.title("AI FAQ Assistant")
window.geometry("600x500")

title = tk.Label(
    window,
    text="AI FAQ ASSISTANT",
    font=("Arial", 18, "bold")
)

title.pack(pady=10)

chat_box = scrolledtext.ScrolledText(
    window,
    width=65,
    height=20,
    font=("Arial", 11)
)

chat_box.pack(padx=10, pady=10)

entry = tk.Entry(
    window,
    width=50,
    font=("Arial", 12)
)

entry.pack(side=tk.LEFT, padx=10, pady=10)

send_button = tk.Button(
    window,
    text="Send",
    command=send_message,
    width=10
)

send_button.pack(side=tk.LEFT)

window.mainloop()
